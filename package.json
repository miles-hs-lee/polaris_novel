{
  "name": "novel",
  "private": true,
  "scripts": {
    "changeset": "changeset",
    "publish:packages": "changeset publish",
    "version:packages": "turbo build && changeset version",
    "build": "turbo build",
    "test": "vitest --run --config vitest.workspace.ts",
    "test:watch": "vitest --config vitest.workspace.ts",
    "test:coverage": "vitest --run --coverage --config vitest.workspace.ts",
    "test:coverage:gate": "pnpm test:coverage",
    "test:regression": "pnpm test:regression:table && pnpm test:regression:collab && pnpm test:regression:math",
    "test:regression:table": "vitest --run --config vitest.workspace.ts -t \"REG-TABLE-\"",
    "test:regression:collab": "vitest --run --config vitest.workspace.ts -t \"REG-COLLAB-\"",
    "test:regression:math": "vitest --run --config vitest.workspace.ts -t \"REG-MATH-\"",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:install": "npx playwright install --with-deps chromium",
    "dev": "turbo dev",
    "format": "turbo format --continue --",
    "format:fix": "turbo format --continue -- --write",
    "lint": "turbo lint --continue --",
    "lint:fix": "turbo lint --continue -- --apply",
    "clean": "turbo clean",
    "release": "turbo run release",
    "prepare": "husky install",
    "typecheck": "turbo typecheck"
  },
  "dependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.29.8",
    "turbo": "^2.3.3"
  },
  "packageManager": "pnpm@9.5.0",
  "pnpm": {
    "overrides": {
      "brace-expansion": "^2.0.2",
      "glob": "^10.5.0",
      "katex": "^0.16.21",
      "linkifyjs": "^4.3.2",
      "markdown-it": "^14.1.1",
      "mdast-util-to-hast": "^13.2.1",
      "minimatch": "^9.0.7",
      "svelte": "^5.53.5",
      "sucrase": "^3.35.1",
      "@manypkg/get-packages>@babel/runtime": "^7.28.6",
      "@commitlint/config-validator>ajv": "^8.18.0",
      "read-yaml-file>js-yaml": "^3.14.2",
      "cosmiconfig>js-yaml": "^4.1.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^3.2.4",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.1"
    ,
    "vitest": "^3.2.4"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "build",
          "chore",
          "ci",
          "clean",
          "doc",
          "feat",
          "fix",
          "perf",
          "ref",
          "revert",
          "style",
          "test"
        ]
      ],
      "subject-case": [
        0,
        "always",
        "sentence-case"
      ],
      "body-leading-blank": [
        2,
        "always",
        true
      ],
      "body-max-line-length": [
        0,
        "always",
        100
      ]
    }
  }
}
